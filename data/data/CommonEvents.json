:[{"code":0,"indent":0,"parameters":[]}],"name":"","switchId":1,"trigger":0},{"id":19,"list":[{"code":0,"indent":0,"parameters":[]}],"name":"","switchId":1,"trigger":0},{"id":20,"list":[{"code":0,"indent":0,"parameters":[]}],"name":"","switchId":1,"trigger":0},{"id":21,"name":"UI_에코페메_창고길_독립보조안내","trigger":0,"switchId":1,"list":[{"code":355,"indent":0,"parameters":["/* Data-only navigation fallback. No quest, score, party or story writes. */\n(() => {\n    const scene = SceneManager._scene;\n    const mapId = $gameMap.mapId();\n    const routes = {\n        15: { x: 9, y: 21, title: '창고로 가는 길  1 / 3', text: '방송국 아래쪽 출구로 나가요.' },\n        9: { x: 1, y: 16, title: '창고로 가는 길  2 / 3', text: '왼쪽 길 끝의 중앙광장 출구로 가요.' },\n        5: { x: 4, y: 12, title: '창고로 가는 길  3 / 3', text: '광장 왼쪽 위, 테미스 뒤 창고 입구로 가요.' }\n    };\n    const route = routes[mapId];\n    if (!scene || !route || scene._dpDataRouteGuide || !$gameSwitches.value(314)) return;\n\n    const root = new Sprite();\n    scene._dpDataRouteGuide = root;\n    const owned = [];\n    function sprite(width, height) {\n        const bitmap = new Bitmap(width, height);\n        bitmap.fontFace = $gameSystem.mainFontFace();\n        const result = new Sprite(bitmap);\n        owned.push(bitmap);\n        root.addChild(result);\n        return result;\n    }\n\n    const panelWidth = Math.min(610, Graphics.width - 32);\n    const panel = sprite(panelWidth, 100);\n    panel.x = Math.round((Graphics.width - panelWidth) / 2);\n    panel.y = 16;\n    panel.bitmap.fillRect(0, 0, panelWidth, 100, 'rgba(17,27,39,0.93)');\n    panel.bitmap.fillRect(0, 0, 5, 100, '#e8cc87');\n    panel.bitmap.fontSize = 21;\n    panel.bitmap.textColor = '#eed9a3';\n    panel.bitmap.drawText(route.title, 18, 7, panelWidth - 36, 27, 'left');\n    panel.bitmap.fontSize = 20;\n    panel.bitmap.textColor = '#ffffff';\n    panel.bitmap.drawText(route.text, 18, 34, panelWidth - 36, 29, 'left');\n    panel.bitmap.fontSize = 17;\n    panel.bitmap.textColor = '#c9d2dc';\n    panel.bitmap.drawText('발밑 화살표를 따라 이동해요. 입구에서는 앞으로 걸어가요.', 18, 64, panelWidth - 36, 24, 'left');\n\n    const next = sprite(64, 64);\n    next.anchor.set(0.5, 0.5);\n    const target = sprite(130, 72);\n    target.anchor.set(0.5, 1);\n    target.bitmap.fontSize = 22;\n    target.bitmap.textColor = '#ffe1a0';\n    target.bitmap.outlineColor = '#182334';\n    target.bitmap.outlineWidth = 5;\n    target.bitmap.drawText('이쪽 입구', 0, 0, 130, 30, 'center');\n    target.bitmap.fontSize = 32;\n    target.bitmap.drawText('▼', 0, 28, 130, 42, 'center');\n\n    const dirs = [2, 4, 6, 8];\n    const glyphs = { 2: '↓', 4: '←', 6: '→', 8: '↑' };\n    let path = [];\n    let signature = '';\n    let lastDirection = 0;\n    let ticks = 0;\n\n    function findPath() {\n        const sx = $gamePlayer.x, sy = $gamePlayer.y;\n        const width = $gameMap.width(), height = $gameMap.height();\n        const start = sy * width + sx, goal = route.y * width + route.x;\n        const queue = [start], parents = new Int32Array(width * height);\n        const directions = new Int8Array(width * height);\n        parents.fill(-1);\n        parents[start] = start;\n        const blocked = new Set();\n        for (const event of $gameMap.events()) {\n            if (event.isNormalPriority() && !event.isThrough()) blocked.add(event.y * width + event.x);\n        }\n        // A closed exit may be a solid touch event: reaching its tile triggers it.\n        blocked.delete(goal);\n        for (let head = 0; head < queue.length && parents[goal] < 0; head++) {\n            const current = queue[head], x = current % width, y = Math.floor(current / width);\n            for (const direction of dirs) {\n                const nx = $gameMap.roundXWithDirection(x, direction);\n                const ny = $gameMap.roundYWithDirection(y, direction);\n                if (!$gameMap.isValid(nx, ny)) continue;\n                const index = ny * width + nx;\n                if (parents[index] >= 0 || blocked.has(index)) continue;\n                if (!$gameMap.isPassable(x, y, direction) || !$gameMap.isPassable(nx, ny, 10 - direction)) continue;\n                parents[index] = current;\n                directions[index] = direction;\n                queue.push(index);\n            }\n        }\n        if (parents[goal] < 0 || goal === start) return [];\n        const result = [];\n        for (let at = goal; at !== start; at = parents[at]) {\n            result.push({ x: at % width, y: Math.floor(at / width), direction: directions[at] });\n        }\n        return result.reverse();\n    }\n\n    root.update = function() {\n        if (SceneManager._scene !== scene || $gameMap.mapId() !== mapId || !$gameSwitches.value(314)) {\n            if (root.parent) root.parent.removeChild(root);\n            scene._dpDataRouteGuide = null;\n            for (const bitmap of owned) bitmap.destroy();\n            root.destroy({ children: true, texture: false, baseTexture: false });\n            return;\n        }\n        root.visible = !$gameMessage.isBusy() && !$gameMap.isEventRunning() && !$gamePlayer.isTransferring();\n        if (!root.visible) return;\n        const questWindow = scene._questGuideWindow;\n        panel.y = 16;\n        if (questWindow && questWindow.visible && questWindow.openness !== 0 &&\n            panel.x < questWindow.x + questWindow.width && panel.x + panelWidth > questWindow.x &&\n            questWindow.y < panel.y + 100 && questWindow.y + questWindow.height > panel.y) {\n            panel.y = Math.max(16, Math.min(questWindow.y + questWindow.height + 8, Graphics.height - 240));\n        }\n        ticks++;\n        const currentSignature = $gamePlayer.x + ',' + $gamePlayer.y;\n        if (signature !== currentSignature || ticks % 30 === 1) {\n            signature = currentSignature;\n            path = findPath();\n        }\n        const tw = $gameMap.tileWidth(), th = $gameMap.tileHeight();\n        target.x = ($gameMap.adjustX(route.x) + 0.5) * tw;\n        target.y = ($gameMap.adjustY(route.y) + 0.2) * th - 4 + Math.sin(ticks / 14) * 4;\n        target.visible = target.x > 0 && target.x < Graphics.width && target.y > 0 && target.y < Graphics.height;\n        next.visible = path.length > 0;\n        if (path.length) {\n            const step = path[0];\n            if (lastDirection !== step.direction) {\n                lastDirection = step.direction;\n                next.bitmap.clear();\n                next.bitmap.fontSize = 44;\n                next.bitmap.textColor = '#ffe1a0';\n                next.bitmap.outlineColor = '#162131';\n                next.bitmap.outlineWidth = 6;\n                next.bitmap.drawText(glyphs[step.direction], 0, 0, 64, 64, 'center');\n            }\n            next.x = ($gameMap.adjustX(step.x) + 0.5) * tw;\n            next.y = ($gameMap.adjustY(step.y) + 0.5) * th;\n            next.opacity = 220 + Math.round(35 * Math.sin(ticks / 10));\n        }\n    };\n    scene.addChild(root);\n    root.update();\n})();\n"]},{"code":0,"indent":0,"parameters":[]}]},{"id":22,"name":"조작_안내_이야기 읽는 방법","trigger":0,"switchId":1,"list":[{"code":108,"indent":0,"parameters":["DP_ASSIST_20261007: instruction only; original outcomes unchanged"]},{"code":355,"indent":0,"parameters":["$gameTemp._dpHelpUiStack=$gameTemp._dpHelpUiStack||[];$gameTemp._dpHelpUiStack.push([157,158,204].map(id=>$gameSwitches.value(id)));$gameSwitches.setValue(157,false);$gameSwitches.setValue(158,true);$gameSwitches.setValue(204,true);"]},{"code":118,"indent":0,"parameters":["DP_HELP_READ"]},{"code":101,"indent":0,"parameters":["",0,0,1,"이야기 읽는 방법"]},{"code":401,"indent":0,"parameters":["\\FS[24]태블릿에서는 화면을 톡 누르면 글을 넘길 수 있어요."]},{"code":401,"indent":0,"parameters":["\\FS[24]화면의 동그란 버튼(○)으로도 다음 글을 봐요."]},{"code":401,"indent":0,"parameters":["\\FS[24]PC에서는 Enter·Z·스페이스 중 하나를 눌러요."]},{"code":401,"indent":0,"parameters":["\\FS[24]이야기가 끝나면 이동·조사 방법을 알려 줄게요."]},{"code":102,"indent":0,"parameters":[["이야기 시작","설명 다시